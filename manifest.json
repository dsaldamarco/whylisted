{
  "manifest_version": 3,
  "name": "Whylisted",
  "short_name": "Whylisted",
  "version": "0.1.0",
  "description": "Remember why it's on your watchlist. Private notes for films on Letterboxd, right on the poster.",
  "homepage_url": "https://github.com/dsaldamarco/whylisted",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://letterboxd.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/*"
      ],
      "js": [
        "src/namespace.js",
        "src/film.js",
        "src/store.js",
        "src/ui/icons.js",
        "src/ui/tooltip.js",
        "src/ui/editor.js",
        "src/ui/badge.js",
        "src/main.js"
      ],
      "css": [
        "src/whylisted.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "whylisted@whylisted.app",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
